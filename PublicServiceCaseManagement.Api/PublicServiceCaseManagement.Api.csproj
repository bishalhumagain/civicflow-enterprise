
<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>8b5fe5bd-a7c6-4383-9605-0cadf115df27</UserSecretsId>
        <AssemblyTitle>CivicFlow Enterprise API</AssemblyTitle>
        <Product>CivicFlow Enterprise</Product>
        <Company>Bishal Humagain</Company>
        <Authors>Bishal Humagain</Authors>
        <Copyright>Copyright © 2026 Bishal Humagain</Copyright>
        <Version>0.1.0</Version>
        <RepositoryUrl>https://github.com/bishalhumagain/civicflow-enterprise</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    </ItemGroup>
</Project>
