{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PublicServiceCaseManagement.Api.Infrastructure.Identity.AuditLogger": "Warning"
    }
  },
  "Application": {
    "Name": "CivicFlow Enterprise"
  },
  "ConnectionStrings": {
    "CivicFlow": "Host=localhost;Port=5432;Database=civicflow;Username=civicflow_runtime;Password=change-me"
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "BusinessEndpoints": {
    "Enabled": false
  },
  "BackgroundJobs": {
    "Enabled": true,
    "Concurrency": 2,
    "PollingMilliseconds": 1000,
    "LeaseSeconds": 300,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 3600,
    "RetentionDays": 90
  },
  "Security": {
    "RequireAntiforgery": true,
    "AbsoluteSessionLifetimeSeconds": 43200
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "FromAddress": "",
    "FromName": "CivicFlow",
    "Username": "",
    "Password": "",
    "UseSsl": true
  },
  "Cors": {
    "_comment": "Production/staging allowlist only. In Development the API already trusts any http://localhost / http://127.0.0.1 origin on any Vite port, so the frontend can hop ports without breaking login.",
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Invitations": {
    "ExpiryHours": 72
  },
  "SeedAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "",
    "ResetPassword": false
  },
  "AllowedHosts": "*"
}
