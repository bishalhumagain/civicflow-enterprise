    {
      "clientId": "civicflow-staff",
      "name": "CivicFlow Staff API Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "civicflow-citizen",
      "name": "CivicFlow Citizen API Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    }
  ]
