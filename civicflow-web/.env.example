# Frontend environment variables (Vite).
#
# Copy this file to `.env.local` (recommended) or `.env` in this directory and
# adjust values for your machine: `cp .env.example .env.local`.
#
# Vite only loads these from the `civicflow-web/` directory. Never commit the
# copied file. The frontend never holds secrets: authentication is handled by
# the CivicFlow API using first-party HttpOnly session cookies, so there are no
# tokens, client secrets, or identity-provider credentials to configure here.

# Base URL of the CivicFlow API launched with the API project's launch profile.
# The standalone API profile listens on port 5001; Docker Compose uses the
# separate API_BASE_URL setting in the repository-root .env file.
VITE_API_BASE_URL=http://localhost:5001
