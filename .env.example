# Copy to .env for local Docker Compose use. Never commit the copied .env file.

# Database Configuration
POSTGRES_PASSWORD=change_me
CIVICFLOW_RUNTIME_PASSWORD=change_me
CIVICFLOW_MIGRATOR_PASSWORD=change_me
POSTGRES_HOST_PORT=5432

# API Configuration
API_HOST_PORT=5000
API_BASE_URL=http://localhost:5000
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change_me_to_a_random_secret_at_least_32_bytes

# Frontend Configuration
FRONTEND_HOST_PORT=5173
FRONTEND_BASE_URL=http://localhost:5173

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@civicflow.example
SMTP_FROM_NAME=CivicFlow
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
